<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_cotizar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:id="@+id/txtTituloCotizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NUEVA COTIZACIÓN"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <LinearLayout
        android:id="@+id/formLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloCotizar">

        <!-- Campo Nombre del Cliente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Cliente:"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtCliente"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej: Ignacio Aguilera"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- Campo Tamaño -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tamaño estimado (en centímetros):"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtTamano"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej: 15"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Opciones de Estilo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estilo del Tatuaje:"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgEstilos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbTradicional"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Tradicional / Blackwork ($5.000 / cm)"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbRealismo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Realismo / Color ($8.000 / cm)"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- MEJORA: CheckBox para abono del 20% -->
        <CheckBox
            android:id="@+id/chkAbono"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Registrar abono de reserva (20%)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>

    <!-- Botón Registrar -->
    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CALCULAR Y REGISTRAR"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00E676"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>