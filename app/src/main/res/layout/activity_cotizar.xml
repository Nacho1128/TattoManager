<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_cotizar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/black_background">

    <TextView
        android:id="@+id/txtTituloCotizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NUEVA COTIZACIÓN"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloCotizar"
        app:layout_constraintBottom_toTopOf="@id/btnCalcular">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nombre del Cliente -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Cliente:"
                android:textColor="@color/text_grey"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtCliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej: Ignacio Aguilera"
                android:textColorHint="@color/hint_grey"
                android:textColor="@color/text_white"
                android:background="@drawable/edit_text_custom"
                android:padding="12dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"/>

            <!-- Tamaño -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamaño estimado (en cm):"
                android:textColor="@color/text_grey"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtTamano"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej: 15"
                android:textColorHint="@color/hint_grey"
                android:textColor="@color/text_white"
                android:background="@drawable/edit_text_custom"
                android:padding="12dp"
                android:inputType="number"
                android:layout_marginBottom="16dp"/>

            <!-- Selección de Fecha y Hora de la Sesión -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha y Hora de la Cita:"
                android:textColor="@color/text_grey"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnSeleccionarFecha"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Elegir Fecha"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/card_background"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnSeleccionarHora"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Elegir Hora"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/card_background"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtFechaHoraSeleccionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cita: No agendada"
                android:textColor="@color/neon_green"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Estilos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estilo del Tatuaje:"
                android:textColor="@color/text_grey"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgEstilos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbTradicional"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Tradicional / Blackwork ($5.000 / cm)"
                    android:textColor="@color/text_white"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbRealismo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Realismo / Color ($8.000 / cm)"
                    android:textColor="@color/text_white" />
            </RadioGroup>

            <!-- CheckBox Abono -->
            <CheckBox
                android:id="@+id/chkAbono"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Registrar abono de reserva (20%)"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CALCULAR Y REGISTRAR"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/neon_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>